<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Monitor nocturno experimental" android:textSize="24sp"
            android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No es un dispositivo medico. No detecta crisis sin movimiento y no reemplaza el protocolo de emergencia." />
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="Detenido" android:textSize="18sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Registros del Watch S1"
            android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Mi Fitness → Health Connect → esta aplicacion"
            android:textSize="13sp" />
        <Button android:id="@+id/syncHealth" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="Autorizar o actualizar ahora" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:padding="12dp"
                android:background="#EAF3F8">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Frecuencia cardiaca" />
                <TextView android:id="@+id/heartRateRecord" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Sin sincronizar"
                    android:textSize="20sp" android:textStyle="bold" android:textColor="#B43745" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:padding="12dp"
                android:layout_marginStart="8dp" android:background="#EAF3F8">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Oxigeno SpO2" />
                <TextView android:id="@+id/oxygenRecord" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Sin sincronizar"
                    android:textSize="20sp" android:textStyle="bold" android:textColor="#386F9E" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/healthStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Autorice ambos datos. Luego se actualizan cada minuto." />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Acelerometro del celular"
            android:textSize="20sp" android:textStyle="bold" />
        <Button android:id="@+id/toggle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Iniciar sesion nocturna" />
        <co.edu.ecci.monitornocturno.AccelerationChartView
            android:id="@+id/accelerationChart"
            android:layout_width="match_parent" android:layout_height="190dp"
            android:layout_marginTop="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Aceleracion en vivo: X rojo · Y verde · Z azul"
            android:textSize="12sp" android:gravity="center" />
        <Button android:id="@+id/confirm" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Marcar evento confirmado" />
        <Button android:id="@+id/falseAlarm" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Marcar falsa alarma" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Coloque el telefono firmemente sobre el colchon y conectado al cargador. Use siempre la misma posicion. Los archivos CSV permanecen en el almacenamiento privado de la app." />
    </LinearLayout>
</ScrollView>
