<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Monitor nocturno experimental" android:textSize="24sp"
            android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No es un dispositivo medico. No detecta crisis sin movimiento y no reemplaza el protocolo de emergencia." />
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="Detenido" android:textSize="18sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Sensor de muneca"
            android:textSize="20sp" android:textStyle="bold" />
        <Button android:id="@+id/connectWatch" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="Buscar y conectar Watch S1" />
        <TextView android:id="@+id/watchStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="● Reloj no conectado" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="10dp" android:padding="12dp"
            android:background="#EAF3F8">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Frecuencia cardiaca\nInicie la medicion en el reloj" />
            <TextView android:id="@+id/heartRate" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="-- lpm"
                android:textSize="26sp" android:textStyle="bold" android:textColor="#B43745" />
        </LinearLayout>
        <Button android:id="@+id/watchDetails" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="Ver detalles tecnicos" />
        <TextView android:id="@+id/watchLog" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:fontFamily="monospace" android:textSize="12sp"
            android:visibility="gone"
            android:text="El diagnostico mostrara servicios y paquetes BLE." />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Acelerometro del celular"
            android:textSize="20sp" android:textStyle="bold" />
        <Button android:id="@+id/toggle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Iniciar sesion nocturna" />
        <co.edu.ecci.monitornocturno.AccelerationChartView
            android:id="@+id/accelerationChart"
            android:layout_width="match_parent" android:layout_height="190dp"
            android:layout_marginTop="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Aceleracion en vivo: X rojo · Y verde · Z azul"
            android:textSize="12sp" android:gravity="center" />
        <Button android:id="@+id/confirm" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Marcar evento confirmado" />
        <Button android:id="@+id/falseAlarm" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Marcar falsa alarma" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Coloque el telefono firmemente sobre el colchon y conectado al cargador. Use siempre la misma posicion. Los archivos CSV permanecen en el almacenamiento privado de la app." />
    </LinearLayout>
</ScrollView>
